{
  "name": "marquee",
  "version": "1.0.0",
  "description": "Cinema pre-show assembler and AirPlay player",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "download-bins": "bun run scripts/download-bins.ts",
    "build:binary": "bun build --compile --target bun --outfile dist/marquee src/index.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "chalk": "^5.6.2",
    "cli-progress": "^3.12.0",
    "env-paths": "^4.0.0",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "multicast-dns": "^7.2.5",
    "node-hue-api": "^5.0.0-beta.16",
    "prompts": "^2.4.2",
    "tmdb-ts": "^2.3.0",
    "yt-dlp-wrap": "^2.3.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/cli-progress": "^3.11.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/multicast-dns": "^7.2.4",
    "@types/prompts": "^2.4.9",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.5",
    "typescript": "~5.9",
    "typescript-eslint": "^8.63.0"
  }
}
