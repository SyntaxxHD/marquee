{
  "name": "marquee",
  "version": "2.0.0",
  "description": "Cinema pre-show assembler and AirPlay player",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "download-bins": "bun run scripts/download-bins.ts",
    "prepare": "husky",
    "dev": "hutch run dev",
    "dev:hmr": "hutch run dev:hmr",
    "build:app": "hutch run build"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "env-paths": "^4.0.0",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "multicast-dns": "^7.2.5",
    "node-hue-api": "^5.0.0-beta.16",
    "simple-icons": "^16.30.0",
    "tmdb-ts": "^2.3.0",
    "yt-dlp-wrap": "^2.3.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/bun": "^1.3.14",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/multicast-dns": "^7.2.4",
    "concurrently": "^10.0.5",
    "electrobun": "^2.0.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "husky": "^9.1.7",
    "lucide-svelte": "^1.0.1",
    "prettier": "^3.9.5",
    "svelte": "^5.57.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.2.2"
  }
}
